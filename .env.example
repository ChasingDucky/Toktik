# 后端环境变量示例
# 复制此文件为 backend/.env 并修改配置

# 服务器配置
PORT=5000
NODE_ENV=development

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/toktik

# JWT配置
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRE=7d

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=104857600

# Docker部署时使用以下配置
# PORT=8667
# MONGODB_URI=mongodb://mongodb:27017/toktik
